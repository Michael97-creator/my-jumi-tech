# Copy these values into Vercel Project Settings > Environment Variables.
# Never put live secrets in frontend files or commit a real .env file.

# Neon PostgreSQL connection string (pooled connection recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Paystack secret key. Use a TEST key while validating the complete flow, then switch to live.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret_key
PAYSTACK_CURRENCY=NGN

# Public deployed origin with no trailing slash
SITE_URL=https://your-deployed-site.vercel.app

# Admin login password: use a unique password with at least 12 characters
ADMIN_PASSWORD=replace_with_a_unique_long_password

# Random secret with at least 32 characters, used to sign the HttpOnly admin session cookie
SESSION_SECRET=replace_with_at_least_32_random_characters_here
